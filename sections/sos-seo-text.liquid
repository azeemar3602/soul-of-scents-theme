{%- if section.settings.seo_text != blank -%}
<style>
  #sos-seo-{{ section.id }} { background: {{ section.settings.bg_color }}; margin-top: {{ section.settings.margin_top }}px; }
  #sos-seo-{{ section.id }} .sos-seo-text__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 {{ section.settings.padding_h }}px; }
  #sos-seo-{{ section.id }} .sos-seo-text__toggle {
    width: 100%; background: none; border: none;
    border-top: 1px solid rgba(0,0,0,0.1); padding: 14px 0;
    display: flex; align-items: center; justify-content: space-between;
    cursor: pointer; font-size: 12px; font-weight: 500; letter-spacing: 0.08em;
    text-transform: uppercase; color: {{ section.settings.text_color }}; opacity: 0.55;
  }
  #sos-seo-{{ section.id }} .sos-seo-text__toggle svg { transition: transform 0.3s ease; }
  #sos-seo-{{ section.id }} .sos-seo-text__toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  #sos-seo-{{ section.id }} .sos-seo-text__body {
    overflow: hidden; max-height: 0; transition: max-height 0.4s ease;
  }
  #sos-seo-{{ section.id }} .sos-seo-text__body.is-open { max-height: 800px; }
  #sos-seo-{{ section.id }} .sos-seo-text__content {
    font-size: {{ section.settings.font_size }}px; color: {{ section.settings.text_color }};
    line-height: 1.75; opacity: {{ section.settings.text_opacity | divided_by: 100.0 }};
    padding-bottom: {{ section.settings.padding_bottom }}px;
    column-count: 2; column-gap: 40px;
  }
  @media (max-width: 749px) { #sos-seo-{{ section.id }} .sos-seo-text__content { column-count: 1; } }
</style>
<div class="sos-seo-text" id="sos-seo-{{ section.id }}" style="padding-top: {{ section.settings.padding_top }}px;">
  <div class="sos-seo-text__inner">
    <button class="sos-seo-text__toggle" aria-expanded="false" aria-controls="sos-seo-body-{{ section.id }}">
      <span>{{ section.settings.heading | default: 'More information' }}</span>
      <svg width="14" height="8" viewBox="0 0 14 8" fill="none" aria-hidden="true">
        <path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="sos-seo-text__body" id="sos-seo-body-{{ section.id }}">
      <div class="sos-seo-text__content rte">{{ section.settings.seo_text }}</div>
    </div>
  </div>
</div>
<script>
(function(){
  var btn = document.querySelector('#sos-seo-{{ section.id }} .sos-seo-text__toggle');
  var body = document.getElementById('sos-seo-body-{{ section.id }}');
  if (!btn || !body) return;
  btn.addEventListener('click', function() {
    var open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    body.classList.toggle('is-open', !open);
  });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "SEO Text Block",
  "tag": "section",
  "class": "sos-seo-section",
  "settings": [
    { "type": "header",   "content": "Content" },
    { "type": "text",     "id": "heading",       "label": "Heading (optional)",        "info": "Leave blank to show body text only." },
    { "type": "richtext", "id": "seo_text",      "label": "SEO text",                  "info": "Write keyword-rich text here. Fully visible to search engines." },
    { "type": "header",   "content": "Style" },
    { "type": "color",    "id": "bg_color",      "label": "Background color",          "default": "#faf9f7" },
    { "type": "color",    "id": "text_color",    "label": "Text color",                "default": "#6b6258" },
    {
      "type": "range", "id": "text_opacity", "label": "Text opacity %",
      "min": 20, "max": 100, "step": 5, "default": 65,
      "info": "Lower = more subdued / visually quiet. Still fully readable by search engines."
    },
    {
      "type": "range", "id": "font_size", "label": "Font size (px)",
      "min": 11, "max": 18, "step": 1, "default": 13
    },
    {
      "type": "select", "id": "font_weight", "label": "Font weight",
      "default": "400",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" }
      ]
    },
    {
      "type": "range", "id": "heading_size", "label": "Heading size (px)",
      "min": 14, "max": 28, "step": 1, "default": 16
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range", "id": "max_width",    "label": "Max width (px)", "min": 600, "max": 1400, "step": 40, "default": 1200
    },
    {
      "type": "range", "id": "padding_top",  "label": "Padding top",    "min": 0, "max": 80, "step": 4, "default": 40, "unit": "px"
    },
    {
      "type": "range", "id": "padding_bottom","label": "Padding bottom", "min": 0, "max": 80, "step": 4, "default": 40, "unit": "px"
    },
    {
      "type": "range", "id": "padding_h",    "label": "Padding sides",  "min": 0, "max": 60, "step": 4, "default": 20, "unit": "px"
    },
    {
      "type": "range", "id": "margin_top",   "label": "Margin top",     "min": 0, "max": 80, "step": 4, "default": 0, "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "SEO Text Block",
      "settings": {
        "seo_text": "<p>Discover niche perfume and olfactory experiences curated for your unique scent identity.</p>",
        "text_opacity": 60,
        "font_size": 13
      }
    }
  ]
}
{% endschema %}
