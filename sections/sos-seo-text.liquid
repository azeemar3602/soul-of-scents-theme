{%- if section.settings.seo_text != blank -%}
<div
  class="sos-seo-text"
  id="sos-seo-{{ section.id }}"
  style="
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_h }}px {{ section.settings.padding_bottom }}px;
    margin-top: {{ section.settings.margin_top }}px;
  "
>
  <div class="sos-seo-text__inner" style="max-width: {{ section.settings.max_width }}px; margin: 0 auto;">
    {%- if section.settings.heading != blank -%}
      <h2 class="sos-seo-text__heading" style="font-size:{{ section.settings.heading_size }}px; color:{{ section.settings.text_color }}; margin:0 0 12px; font-weight:{{ section.settings.font_weight }};">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    <div class="sos-seo-text__body" style="font-size:{{ section.settings.font_size }}px; color:{{ section.settings.text_color }}; line-height:1.7; opacity:{{ section.settings.text_opacity | divided_by: 100.0 }};">
      {{ section.settings.seo_text }}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "SEO Text Block",
  "tag": "section",
  "class": "sos-seo-section",
  "settings": [
    { "type": "header",   "content": "Content" },
    { "type": "text",     "id": "heading",       "label": "Heading (optional)",        "info": "Leave blank to show body text only." },
    { "type": "richtext", "id": "seo_text",      "label": "SEO text",                  "info": "Write keyword-rich text here. Fully visible to search engines." },
    { "type": "header",   "content": "Style" },
    { "type": "color",    "id": "bg_color",      "label": "Background color",          "default": "#faf9f7" },
    { "type": "color",    "id": "text_color",    "label": "Text color",                "default": "#6b6258" },
    {
      "type": "range", "id": "text_opacity", "label": "Text opacity %",
      "min": 20, "max": 100, "step": 5, "default": 65,
      "info": "Lower = more subdued / visually quiet. Still fully readable by search engines."
    },
    {
      "type": "range", "id": "font_size", "label": "Font size (px)",
      "min": 11, "max": 18, "step": 1, "default": 13
    },
    {
      "type": "select", "id": "font_weight", "label": "Font weight",
      "default": "400",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" }
      ]
    },
    {
      "type": "range", "id": "heading_size", "label": "Heading size (px)",
      "min": 14, "max": 28, "step": 1, "default": 16
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "range", "id": "max_width",    "label": "Max width (px)", "min": 600, "max": 1400, "step": 40, "default": 1200
    },
    {
      "type": "range", "id": "padding_top",  "label": "Padding top",    "min": 0, "max": 80, "step": 4, "default": 40, "unit": "px"
    },
    {
      "type": "range", "id": "padding_bottom","label": "Padding bottom", "min": 0, "max": 80, "step": 4, "default": 40, "unit": "px"
    },
    {
      "type": "range", "id": "padding_h",    "label": "Padding sides",  "min": 0, "max": 60, "step": 4, "default": 20, "unit": "px"
    },
    {
      "type": "range", "id": "margin_top",   "label": "Margin top",     "min": 0, "max": 80, "step": 4, "default": 0, "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "SEO Text Block",
      "settings": {
        "seo_text": "<p>Discover niche perfume and olfactory experiences curated for your unique scent identity.</p>",
        "text_opacity": 60,
        "font_size": 13
      }
    }
  ]
}
{% endschema %}
