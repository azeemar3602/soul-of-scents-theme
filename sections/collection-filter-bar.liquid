{%- render 'collection-filter-bar-content',
  bar_title: section.settings.bar_title,
  trigger_label: section.settings.trigger_label,
  col_left_title: section.settings.col_left_title,
  col_right_title: section.settings.col_right_title,
  col_size_title: section.settings.col_size_title,
  show_all_link: section.settings.show_all_link,
  exclude_collection_handles: section.settings.exclude_collection_handles,
  brand_label_1: section.settings.brand_label_1, brand_url_1: section.settings.brand_url_1,
  brand_label_2: section.settings.brand_label_2, brand_url_2: section.settings.brand_url_2,
  brand_label_3: section.settings.brand_label_3, brand_url_3: section.settings.brand_url_3,
  brand_label_4: section.settings.brand_label_4, brand_url_4: section.settings.brand_url_4,
  brand_label_5: section.settings.brand_label_5, brand_url_5: section.settings.brand_url_5,
  brand_label_6: section.settings.brand_label_6, brand_url_6: section.settings.brand_url_6,
  brand_label_7: section.settings.brand_label_7, brand_url_7: section.settings.brand_url_7,
  brand_label_8: section.settings.brand_label_8, brand_url_8: section.settings.brand_url_8,
  brand_label_9: section.settings.brand_label_9, brand_url_9: section.settings.brand_url_9,
  brand_label_10: section.settings.brand_label_10, brand_url_10: section.settings.brand_url_10,
  size_label_1: section.settings.size_label_1, size_url_1: section.settings.size_url_1,
  size_label_2: section.settings.size_label_2, size_url_2: section.settings.size_url_2,
  size_label_3: section.settings.size_label_3, size_url_3: section.settings.size_url_3,
  size_label_4: section.settings.size_label_4, size_url_4: section.settings.size_url_4,
  size_label_5: section.settings.size_label_5, size_url_5: section.settings.size_url_5,
  section_width: section.settings.section_width,
  custom_width: section.settings.custom_width,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom,
  margin_top: section.settings.margin_top,
  margin_bottom: section.settings.margin_bottom
-%}

{% schema %}
{
  "name": "Collection Filter Bar",
  "tag": "section",
  "class": "section-collection-filter-bar",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "default": "full",
      "options": [
        { "value": "full",      "label": "Full Width" },
        { "value": "container", "label": "Container" },
        { "value": "boxed",     "label": "Boxed" },
        { "value": "custom",    "label": "Custom Width" }
      ]
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width (px)",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200,
      "info": "Only used when 'Custom Width' is selected above."
    },
    {
      "type": "header",
      "content": "Bar Labels"
    },
    {
      "type": "text",
      "id": "bar_title",
      "label": "Left title override",
      "info": "Leave blank to auto-use the collection name."
    },
    {
      "type": "text",
      "id": "trigger_label",
      "label": "Filter button label",
      "default": "FILTER"
    },
    {
      "type": "header",
      "content": "Dropdown Columns"
    },
    {
      "type": "text",
      "id": "col_left_title",
      "label": "Left column heading",
      "default": "Categories"
    },
    {
      "type": "text",
      "id": "col_right_title",
      "label": "Right column heading",
      "default": "Brand"
    },
    {
      "type": "text",
      "id": "col_size_title",
      "label": "Size column heading",
      "default": "Size"
    },
    {
      "type": "checkbox",
      "id": "show_all_link",
      "label": "Show 'All products' link in Categories",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "textarea",
      "id": "exclude_collection_handles",
      "label": "Exclude collection handles",
      "info": "Comma-separated. e.g. meo-fuscioni,sarah-baker,frontpage"
    },
    {
      "type": "header",
      "content": "Brand Links — add up to 10"
    },
    { "type": "text", "id": "brand_label_1",  "label": "Brand 1 — name" },
    { "type": "url",  "id": "brand_url_1",    "label": "Brand 1 — URL" },
    { "type": "text", "id": "brand_label_2",  "label": "Brand 2 — name" },
    { "type": "url",  "id": "brand_url_2",    "label": "Brand 2 — URL" },
    { "type": "text", "id": "brand_label_3",  "label": "Brand 3 — name" },
    { "type": "url",  "id": "brand_url_3",    "label": "Brand 3 — URL" },
    { "type": "text", "id": "brand_label_4",  "label": "Brand 4 — name" },
    { "type": "url",  "id": "brand_url_4",    "label": "Brand 4 — URL" },
    { "type": "text", "id": "brand_label_5",  "label": "Brand 5 — name" },
    { "type": "url",  "id": "brand_url_5",    "label": "Brand 5 — URL" },
    { "type": "text", "id": "brand_label_6",  "label": "Brand 6 — name" },
    { "type": "url",  "id": "brand_url_6",    "label": "Brand 6 — URL" },
    { "type": "text", "id": "brand_label_7",  "label": "Brand 7 — name" },
    { "type": "url",  "id": "brand_url_7",    "label": "Brand 7 — URL" },
    { "type": "text", "id": "brand_label_8",  "label": "Brand 8 — name" },
    { "type": "url",  "id": "brand_url_8",    "label": "Brand 8 — URL" },
    { "type": "text", "id": "brand_label_9",  "label": "Brand 9 — name" },
    { "type": "url",  "id": "brand_url_9",    "label": "Brand 9 — URL" },
    { "type": "text", "id": "brand_label_10", "label": "Brand 10 — name" },
    { "type": "url",  "id": "brand_url_10",   "label": "Brand 10 — URL" },
    {
      "type": "header",
      "content": "Size Links — add up to 5"
    },
    { "type": "text", "id": "size_label_1", "label": "Size 1 — label", "default": "50ml" },
    { "type": "url",  "id": "size_url_1",   "label": "Size 1 — URL" },
    { "type": "text", "id": "size_label_2", "label": "Size 2 — label", "default": "100ml" },
    { "type": "url",  "id": "size_url_2",   "label": "Size 2 — URL" },
    { "type": "text", "id": "size_label_3", "label": "Size 3 — label" },
    { "type": "url",  "id": "size_url_3",   "label": "Size 3 — URL" },
    { "type": "text", "id": "size_label_4", "label": "Size 4 — label" },
    { "type": "url",  "id": "size_url_4",   "label": "Size 4 — URL" },
    { "type": "text", "id": "size_label_5", "label": "Size 5 — label" },
    { "type": "url",  "id": "size_url_5",   "label": "Size 5 — URL" }
  ],
  "presets": [
    { "name": "Collection Filter Bar" }
  ]
}
{% endschema %}
