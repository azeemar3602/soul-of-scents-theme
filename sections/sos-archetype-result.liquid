{%- comment -%}
  SOS Archetype Result Section (block-based) v2
  Used by templates/page.archetype-result.json and per-archetype templates
  (templates/page.archetype-the-seducer.json etc.).

  Each archetype page should be assigned to its own dedicated template so the
  block content (images, copy, layout) can be edited PER PAGE in the customizer.

  The Product source (RH collection) is auto-resolved from the page handle:
    /pages/the-mineralist  ->  collections['rh-the-mineralist']
  No per-page collection picking is needed.
{%- endcomment -%}

{%- liquid
  assign archetype_name = page.title | replace: 'RH - ', '' | strip

  comment
  Collection resolution (per page, not per section setting):
    1. page.metafields.custom.rh_collection  (per-page metafield override)
    2. collections['rh-' + page.handle]      (auto-resolve)
  endcomment
  assign source_col = blank
  if page.metafields.custom.rh_collection != blank
    assign source_col = page.metafields.custom.rh_collection.value
  elsif page.handle != blank
    assign auto_handle = 'rh-' | append: page.handle
    assign auto_col = collections[auto_handle]
    if auto_col != blank and auto_col.id != blank
      assign source_col = auto_col
    endif
  endif
-%}

<style>
  .sos-arch{ --fg:#030303; --bg:#fbf9f6; --card:#ffffff; --muted:#6b6258; --line:#ece8e3; }
  .sos-arch{ background:var(--bg); color:var(--fg); }
  .sos-arch__wrap{ max-width:1240px; margin:0 auto; padding:0 24px; }
  .sos-arch__block{ padding:48px 0; }
  .sos-arch__block--tight{ padding:24px 0; }

  /* HERO */
  .sos-arch-hero{ text-align:center; padding:80px 0 56px; }
  .sos-arch-hero__overline{ font-size:12px; letter-spacing:.18em; text-transform:uppercase; color:var(--muted); margin:0 0 14px; }
  .sos-arch-hero__title{ font-family:var(--g-font-2, 'EB Garamond', Georgia, serif); font-weight:400; font-size:clamp(48px, 7vw, 88px); line-height:1.02; letter-spacing:-.01em; margin:0; }
  .sos-arch-hero__title em{ font-style:italic; }
  .sos-arch-hero__subtitle{ font-size:16px; color:var(--muted); margin:18px auto 0; max-width:640px; line-height:1.55; }
  .sos-arch-hero__cta{ display:inline-flex; align-items:center; justify-content:center; height:46px; padding:0 28px; margin-top:28px; border:1px solid var(--fg); border-radius:4px; font-size:13px; letter-spacing:.06em; text-transform:uppercase; text-decoration:none; color:var(--fg); background:transparent; transition:opacity .2s; }
  .sos-arch-hero__cta:hover{ opacity:.7; }

  /* IMAGE ROW */
  .sos-arch-row{ display:grid; grid-template-columns:repeat(3, 1fr); gap:18px; align-items:start; }
  .sos-arch-row--2{ grid-template-columns:repeat(2, 1fr); }
  .sos-arch-row--1{ grid-template-columns:1fr; max-width:840px; margin:0 auto; }
  .sos-arch-row__cell{ overflow:hidden; border-radius:8px; background:var(--line); }
  .sos-arch-row__cell img{ width:100%; height:auto; object-fit:cover; display:block; }
  /* Per-image vertical rhythm: each column carries its own aspect via the image. */
  .sos-arch-row__cell--portrait{ aspect-ratio:4/5; }
  .sos-arch-row__cell--portrait img{ height:100%; }
  .sos-arch-row__cell--landscape{ aspect-ratio:5/4; }
  .sos-arch-row__cell--landscape img{ height:100%; }
  .sos-arch-row__cell--square{ aspect-ratio:1/1; }
  .sos-arch-row__cell--square img{ height:100%; }

  /* TEXT */
  .sos-arch-text{ max-width:760px; margin:0 auto; text-align:center; }
  .sos-arch-text--left{ text-align:left; }
  .sos-arch-text__quote{ font-family:var(--g-font-2, 'EB Garamond', Georgia, serif); font-style:italic; font-size:clamp(20px, 2.4vw, 26px); line-height:1.5; color:var(--fg); margin:0; }
  .sos-arch-text__body{ font-size:16px; line-height:1.7; color:var(--fg); }
  .sos-arch-text__body p{ margin:0 0 1em; }

  /* READ MORE / ACCORDION */
  .sos-arch-readmore{ text-align:center; }
  .sos-arch-readmore details{ max-width:760px; margin:0 auto; }
  .sos-arch-readmore summary{ display:inline-block; padding:12px 32px; border:1px solid var(--fg); border-radius:4px; cursor:pointer; font-size:13px; letter-spacing:.06em; text-transform:uppercase; list-style:none; transition:opacity .2s; }
  .sos-arch-readmore summary::-webkit-details-marker{ display:none; }
  .sos-arch-readmore summary:hover{ opacity:.7; }
  .sos-arch-readmore details[open] summary{ margin-bottom:24px; }
  .sos-arch-readmore__body{ font-size:16px; line-height:1.7; color:var(--fg); text-align:left; }
  .sos-arch-readmore__body p{ margin:0 0 1em; }

  /* PRODUCTS */
  .sos-arch-products{ padding:64px 0; }
  .sos-arch-products__head{ text-align:center; margin:0 0 36px; }
  .sos-arch-products__title{ font-family:var(--g-font-2, 'EB Garamond', Georgia, serif); font-weight:400; font-size:clamp(28px, 3.5vw, 40px); margin:0 0 8px; }
  .sos-arch-products__title em{ font-style:italic; }
  .sos-arch-products__sub{ font-size:14px; color:var(--muted); margin:0; }
  .sos-arch-products__grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:24px 20px; align-items:start; }
  .sos-arch-products__empty{ padding:40px; text-align:center; color:var(--muted); border:1px dashed var(--line); border-radius:8px; }

  /* ── Card alignment fixes inside archetype grid ───────────────────────── */
  /* Stretch cards to fill their grid cell so overlay buttons stay consistent */
  .sos-arch-products__grid .product-card{ display:flex; flex-direction:column; height:100%; }
  .sos-arch-products__grid .product-card__image-wr{ flex-shrink:0; }
  .sos-arch-products__grid .product-card__info{ flex:1; display:flex; flex-direction:column; }
  /* Pin price to the bottom of the info block so all cards align */
  .sos-arch-products__grid .product-card__price{ margin-top:auto; padding-top:6px; }
  /* Give mood-tag rows a fixed minimum height so 1-tag vs 2-tag cards don't differ */
  .sos-arch-products__grid .mood-tags-block{ min-height:30px; display:flex; flex-wrap:wrap; gap:4px; align-content:flex-start; margin-bottom:4px; }
  /* Overlay buttons: ensure they sit flush at the bottom of the image wrapper */
  .sos-arch-products__grid .product-card__overlay{ bottom:0; width:100%; }

  /* SAMPLE SET */
  .sos-arch-sample{ padding:48px 0 32px; }
  .sos-arch-sample__card{ display:grid; grid-template-columns:300px 1fr; gap:40px; align-items:center; background:var(--bg,#fbf9f6); border:1px solid var(--line,#ece8e3); border-radius:12px; overflow:hidden; }
  .sos-arch-sample__img{ aspect-ratio:1/1; overflow:hidden; background:var(--line,#ece8e3); }
  .sos-arch-sample__img img{ width:100%; height:100%; object-fit:cover; display:block; }
  .sos-arch-sample__body{ padding:32px 40px 32px 0; }
  .sos-arch-sample__eyebrow{ font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--muted,#6f6862); margin:0 0 10px; }
  .sos-arch-sample__title{ font-family:var(--g-font-2,'EB Garamond',Georgia,serif); font-weight:400; font-size:clamp(22px,2.4vw,30px); line-height:1.15; margin:0 0 12px; color:var(--fg,#030303); }
  .sos-arch-sample__desc{ font-size:15px; line-height:1.7; color:var(--muted,#6f6862); margin:0 0 18px; }
  .sos-arch-sample__price{ font-size:17px; font-weight:500; color:var(--fg,#030303); margin:0 0 20px; }
  .sos-arch-sample__btn{ display:inline-flex; align-items:center; justify-content:center; height:46px; padding:0 28px; background:var(--fg,#030303); color:#fff; border:0; border-radius:4px; font-size:12px; letter-spacing:.08em; text-transform:uppercase; cursor:pointer; transition:opacity .2s; }
  .sos-arch-sample__btn:hover{ opacity:.82; }
  .sos-arch-sample__btn:disabled{ background:var(--line,#ece8e3); color:var(--muted,#6f6862); cursor:not-allowed; }
  .sos-arch-sample__btn.is-loading{ opacity:.7; cursor:progress; }
  .sos-arch-sample__btn.is-success{ background:#2a6b2a; }
  .sos-arch-sample__msg{ min-height:1.2em; margin:10px 0 0; font-size:13px; line-height:1.5; color:var(--muted,#6f6862); }
  .sos-arch-sample__msg.is-error{ color:#8a2424; }
  .sos-arch-sample__msg.is-success{ color:#2a6b2a; }
  @media(max-width:760px){
    .sos-arch-sample__card{ grid-template-columns:1fr; gap:0; }
    .sos-arch-sample__img{ aspect-ratio:16/9; }
    .sos-arch-sample__body{ padding:24px 20px; }
  }

  /* SHARE — two centred buttons */
  .sos-arch-share {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 8px 0 48px;
    text-align: center;
  }

  .sos-arch-share__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    align-items: center;
  }

  /* Shared button base */
  .sos-arch-share__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 48px;
    padding: 0 28px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .04em;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid var(--fg, #030303);
    background: transparent;
    color: var(--fg, #030303);
    transition: background .2s, color .2s, opacity .2s;
    white-space: nowrap;
    line-height: 1;
    font-family: inherit;
  }

  .sos-arch-share__btn:hover {
    background: var(--fg, #030303);
    color: #fff;
  }

  /* Filled variant — download/primary */
  .sos-arch-share__btn--filled {
    background: var(--fg, #030303);
    color: #fff;
  }

  .sos-arch-share__btn--filled:hover {
    opacity: .78;
    background: var(--fg, #030303);
    color: #fff;
  }

  .sos-arch-share__btn svg { flex-shrink: 0; }

  @media (max-width: 760px) {
    .sos-arch-share { padding: 0 0 40px; gap: 14px; }
    .sos-arch-share__btns { flex-direction: column; width: 100%; }
    .sos-arch-share__btn { width: 100%; max-width: 280px; }
  }

  /* SPACER */
  .sos-arch-spacer{ height:32px; }

  @media (max-width: 760px){
    .sos-arch-hero{ padding:56px 0 40px; text-align:center; }
    /* Heading: scale down so long names like "The Maximalist" never overflow */
    .sos-arch-hero__title{ font-size:clamp(36px, 11vw, 64px); word-break:break-word; overflow-wrap:break-word; }
    .sos-arch__block{ padding:32px 0; }
    /* 3-col image row → 2-col; lone 3rd image auto-centred */
    .sos-arch-row{ grid-template-columns:repeat(2, 1fr); gap:10px; }
    .sos-arch-row--3 > *:nth-child(3):last-child{
      grid-column: 1 / -1;
      max-width: 50%;
      margin: 0 auto;
      justify-self: center;
      width: 100%;
    }
    .sos-arch-row--1{ grid-template-columns:1fr; }
    .sos-arch-products__grid{ grid-template-columns:repeat(2, 1fr); gap:12px; }
    .sos-arch-products{ padding:48px 0; }
    .sos-arch-share{ padding:28px 20px; }
  }
</style>

<section class="sos-arch" data-section-id="{{ section.id }}" data-archetype="{{ archetype_name | handleize }}">
  <div class="sos-arch__wrap">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

        {%- when 'hero' -%}
          {%- capture hero_style -%}
            {%- if block.settings.max_width != blank -%}max-width:{{ block.settings.max_width }}px;margin-left:auto;margin-right:auto;{%- endif -%}
            {%- if block.settings.background_color != blank -%}background-color:{{ block.settings.background_color }};{%- endif -%}
            {%- if block.settings.padding_top != blank -%}padding-top:{{ block.settings.padding_top }}px;{%- endif -%}
            {%- if block.settings.padding_bottom != blank -%}padding-bottom:{{ block.settings.padding_bottom }}px;{%- endif -%}
          {%- endcapture -%}
          {%- capture title_style -%}
            {%- if block.settings.title_size != blank -%}font-size:{{ block.settings.title_size }}px;{%- endif -%}
            {%- if block.settings.title_color != blank -%}color:{{ block.settings.title_color }};{%- endif -%}
          {%- endcapture -%}
          {%- capture subtitle_style -%}
            {%- if block.settings.subtitle_size != blank -%}font-size:{{ block.settings.subtitle_size }}px;{%- endif -%}
            {%- if block.settings.subtitle_color != blank -%}color:{{ block.settings.subtitle_color }};{%- endif -%}
          {%- endcapture -%}
          <div class="sos-arch-hero" style="{{ hero_style | strip }}" {{ block.shopify_attributes }}>
            {%- if block.settings.overline != blank -%}
              <p class="sos-arch-hero__overline">{{ block.settings.overline }}</p>
            {%- endif -%}
            <h1 class="sos-arch-hero__title" style="{{ title_style | strip }}">
              {%- if block.settings.italicize_name -%}
                <em>{{ block.settings.archetype_name | default: archetype_name }}</em>
              {%- else -%}
                {{ block.settings.archetype_name | default: archetype_name }}
              {%- endif -%}
            </h1>
            {%- if block.settings.subtitle != blank -%}
              <p class="sos-arch-hero__subtitle" style="{{ subtitle_style | strip }}">{{ block.settings.subtitle }}</p>
            {%- endif -%}
            {%- if block.settings.cta_text != blank and block.settings.cta_url != blank -%}
              <a href="{{ block.settings.cta_url }}" class="sos-arch-hero__cta">{{ block.settings.cta_text }}</a>
            {%- endif -%}
          </div>

        {%- when 'image_row' -%}
          {%- comment -%} columns is a string ("1"/"2"/"3"); cast to int for comparison {%- endcomment -%}
          {%- assign cols = block.settings.columns | default: '3' | plus: 0 -%}
          {%- assign aspect = block.settings.aspect | default: 'natural' -%}
          {%- assign cell_class = 'sos-arch-row__cell' -%}
          {%- if aspect != 'natural' -%}
            {%- assign cell_class = cell_class | append: ' sos-arch-row__cell--' | append: aspect -%}
          {%- endif -%}
          <div class="sos-arch__block" {{ block.shopify_attributes }}>
            <div class="sos-arch-row sos-arch-row--{{ cols }}">
              {%- if block.settings.image_1 != blank -%}
                <div class="{{ cell_class }}"><img src="{{ block.settings.image_1 | image_url: width: 800 }}" alt="{{ block.settings.image_1.alt | default: archetype_name | escape }}" loading="lazy" width="{{ block.settings.image_1.width }}" height="{{ block.settings.image_1.height }}"></div>
              {%- endif -%}
              {%- if cols >= 2 and block.settings.image_2 != blank -%}
                <div class="{{ cell_class }}"><img src="{{ block.settings.image_2 | image_url: width: 800 }}" alt="{{ block.settings.image_2.alt | default: archetype_name | escape }}" loading="lazy" width="{{ block.settings.image_2.width }}" height="{{ block.settings.image_2.height }}"></div>
              {%- endif -%}
              {%- if cols >= 3 and block.settings.image_3 != blank -%}
                <div class="{{ cell_class }}"><img src="{{ block.settings.image_3 | image_url: width: 800 }}" alt="{{ block.settings.image_3.alt | default: archetype_name | escape }}" loading="lazy" width="{{ block.settings.image_3.width }}" height="{{ block.settings.image_3.height }}"></div>
              {%- endif -%}
            </div>
          </div>

        {%- when 'text' -%}
          {%- capture text_wrap_style -%}
            {%- if block.settings.max_width != blank -%}max-width:{{ block.settings.max_width }}px;{%- endif -%}
            {%- if block.settings.background_color != blank -%}background-color:{{ block.settings.background_color }};{%- endif -%}
            {%- if block.settings.padding_top != blank -%}padding-top:{{ block.settings.padding_top }}px;{%- endif -%}
            {%- if block.settings.padding_bottom != blank -%}padding-bottom:{{ block.settings.padding_bottom }}px;{%- endif -%}
          {%- endcapture -%}
          {%- capture text_style -%}
            {%- if block.settings.font_size != blank -%}font-size:{{ block.settings.font_size }}px;{%- endif -%}
            {%- if block.settings.line_height != blank -%}line-height:{{ block.settings.line_height }};{%- endif -%}
            {%- if block.settings.color != blank -%}color:{{ block.settings.color }};{%- endif -%}
            {%- if block.settings.font_weight != blank -%}font-weight:{{ block.settings.font_weight }};{%- endif -%}
          {%- endcapture -%}
          <div class="sos-arch__block" {{ block.shopify_attributes }}>
            <div class="sos-arch-text sos-arch-text--{{ block.settings.align | default: 'center' }}" style="{{ text_wrap_style | strip }}">
              {%- if block.settings.style == 'quote' -%}
                {%- comment -%} Strip the rich-text wrapper <p> so the quote class applies cleanly. {%- endcomment -%}
                {%- assign quote_text = block.settings.content | replace: '<p>', '' | replace: '</p>', '' -%}
                <p class="sos-arch-text__quote" style="{{ text_style | strip }}">{{ quote_text }}</p>
              {%- else -%}
                <div class="sos-arch-text__body rte" style="{{ text_style | strip }}">{{ block.settings.content }}</div>
              {%- endif -%}
            </div>
          </div>

        {%- when 'read_more' -%}
          <div class="sos-arch__block sos-arch__block--tight" {{ block.shopify_attributes }}>
            <div class="sos-arch-readmore">
              <details>
                <summary>{{ block.settings.label | default: 'Read more' }}</summary>
                <div class="sos-arch-readmore__body rte">{{ block.settings.content }}</div>
              </details>
            </div>
          </div>

        {%- when 'products' -%}
          <div class="sos-arch-products" {{ block.shopify_attributes }}>
            <div class="sos-arch-products__head">
              <h2 class="sos-arch-products__title">
                {%- if block.settings.title contains '|' -%}
                  {%- assign t_parts = block.settings.title | split: '|' -%}
                  {%- if t_parts.size == 3 -%}
                    {{ t_parts[0] | strip }} <em>{{ t_parts[1] | strip }}</em> {{ t_parts[2] | strip }}
                  {%- else -%}
                    {{ t_parts[0] | strip }}<em>{{ t_parts[1] | strip | prepend: ' ' }}</em>
                  {%- endif -%}
                {%- elsif block.settings.title != blank -%}
                  {{ block.settings.title }}
                {%- else -%}
                  The <em>{{ archetype_name }}'s</em> companions
                {%- endif -%}
              </h2>
              {%- if block.settings.subtitle != blank -%}
                <p class="sos-arch-products__sub">{{ block.settings.subtitle }}</p>
              {%- endif -%}
            </div>
            {%- assign limit = block.settings.product_limit | default: 6 -%}
            {%- if source_col != blank and source_col.products.size > 0 -%}
              <div class="sos-arch-products__grid">
                {%- for product in source_col.products limit: limit -%}
                  {%- render 'product-card', product: product, collection: source_col, enable_edit_item: true, select_item: 'product-10' -%}
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="sos-arch-products__empty">
                Create a collection named "RH - {{ archetype_name }}" (handle: <code>rh-{{ page.handle }}</code>) to auto-bind products, or set a page metafield.
              </div>
            {%- endif -%}
          </div>

        {%- when 'sample_set' -%}
          {%- liquid
            comment
              Try 4 handle patterns in order — whichever the merchant used when creating the product:
              1. indulger-sample-set          (slug-sample-set)
              2. the-indulger-sample-set      (page.handle-sample-set)
              3. sample-the-indulger          (sample-page.handle)
              4. sample-indulger              (sample-slug)
            endcomment
            assign _slug           = page.handle | remove: 'the-'
            assign _sample_product = blank

            assign _try = _slug | append: '-sample-set'
            if all_products[_try] != blank
              assign _sample_product = all_products[_try]
            endif

            unless _sample_product != blank
              assign _try = page.handle | append: '-sample-set'
              if all_products[_try] != blank
                assign _sample_product = all_products[_try]
              endif
            endunless

            unless _sample_product != blank
              assign _try = 'sample-' | append: page.handle
              if all_products[_try] != blank
                assign _sample_product = all_products[_try]
              endif
            endunless

            unless _sample_product != blank
              assign _try = 'sample-' | append: _slug
              if all_products[_try] != blank
                assign _sample_product = all_products[_try]
              endif
            endunless

            assign _sample_variant = _sample_product.selected_or_first_available_variant
          -%}
          {%- if _sample_product != blank -%}
          <div class="sos-arch__block sos-arch-sample" {{ block.shopify_attributes }}>
            <div class="sos-arch-sample__card">
              {%- if _sample_product.featured_image -%}
                <div class="sos-arch-sample__img">
                  <img src="{{ _sample_product.featured_image | image_url: width: 700 }}"
                       srcset="{{ _sample_product.featured_image | image_url: width: 400 }} 400w, {{ _sample_product.featured_image | image_url: width: 700 }} 700w"
                       sizes="(max-width:760px) 100vw, 300px"
                       alt="{{ _sample_product.featured_image.alt | default: _sample_product.title | escape }}"
                       loading="lazy"
                       width="{{ _sample_product.featured_image.width }}"
                       height="{{ _sample_product.featured_image.height }}">
                </div>
              {%- endif -%}
              <div class="sos-arch-sample__body">
                <p class="sos-arch-sample__eyebrow">{{ block.settings.eyebrow | default: 'Sample Set' }}</p>
                <h3 class="sos-arch-sample__title">{{ _sample_product.title }}</h3>
                {%- assign _desc = block.settings.description | default: _sample_product.description -%}
                {%- if _desc != blank -%}
                  <p class="sos-arch-sample__desc">{{ _desc | strip_html | truncate: 180 }}</p>
                {%- endif -%}
                <p class="sos-arch-sample__price">{{ _sample_variant.price | money }}</p>
                {%- if _sample_variant.available -%}
                  <button type="button"
                          class="sos-arch-sample__btn"
                          data-sos-sample-add
                          data-variant-id="{{ _sample_variant.id }}"
                          data-section="{{ section.id }}">
                    {{ block.settings.btn_text | default: 'Add to Cart' }}
                  </button>
                {%- else -%}
                  <button type="button" class="sos-arch-sample__btn" disabled>Sold out</button>
                {%- endif -%}
                <p class="sos-arch-sample__msg" id="sos-sample-msg-{{ section.id }}" role="status" aria-live="polite"></p>
              </div>
            </div>
          </div>
          {%- endif -%}

        {%- when 'share' -%}
          {%- assign share_download_url = block.settings.download_url -%}
          <div class="sos-arch__block" {{ block.shopify_attributes }}>
            <div class="sos-arch-share">
              <div class="sos-arch-share__btns">

                {%- comment -%} Button 1 — Share with friends via Web Share API {%- endcomment -%}
                <button
                  type="button"
                  class="sos-arch-share__btn"
                  data-sos-share
                  data-share-title="{{ archetype_name | escape }}"
                  data-share-text="{{ block.settings.share_text | default: 'My scent archetype is ' | append: archetype_name | escape }}"
                  data-share-url="{{ share_download_url | default: page.url | prepend: shop.url }}"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="18" cy="5" r="3" stroke="currentColor" stroke-width="1.8"/>
                    <circle cx="6" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
                    <circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="1.8"/>
                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" stroke="currentColor" stroke-width="1.8"/>
                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" stroke="currentColor" stroke-width="1.8"/>
                  </svg>
                  {{ block.settings.btn_share_label | default: 'Share with friends' }}
                </button>

                {%- comment -%} Button 2 — Download one-pager {%- endcomment -%}
                {%- if share_download_url != blank -%}
                  <a
                    href="{{ share_download_url }}"
                    class="sos-arch-share__btn sos-arch-share__btn--filled"
                    download
                  >
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M8 1v9M8 10l-3-3M8 10l3-3M2 13h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    {{ block.settings.btn_download_label | default: 'Download your profile' }}
                  </a>
                {%- endif -%}

              </div>
            </div>
          </div>

        {%- when 'spacer' -%}
          <div class="sos-arch-spacer" style="height:{{ block.settings.height | default: 32 }}px;" {{ block.shopify_attributes }}></div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

<script>
/* ── Web Share API — "Share with friends" button ────────────────────────
   Opens the native share sheet (WhatsApp, iMessage, Instagram, etc.)
   Falls back to copying the URL to clipboard on unsupported browsers.   */
(function () {
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-sos-share]');
    if (!btn) return;

    var shareData = {
      title: btn.dataset.shareTitle || document.title,
      text:  btn.dataset.shareText  || '',
      url:   btn.dataset.shareUrl   || window.location.href
    };

    if (navigator.share) {
      navigator.share(shareData).catch(function () {}); /* user cancelled — ignore */
    } else {
      /* Clipboard fallback */
      try {
        navigator.clipboard.writeText(shareData.url).then(function () {
          var orig = btn.textContent.trim();
          btn.textContent = 'Link copied!';
          setTimeout(function () { btn.textContent = orig; }, 2200);
        });
      } catch (_) {
        window.prompt('Copy this link:', shareData.url);
      }
    }
  });
})();
</script>

<script>
/* Sample-set Add to Cart — delegated, handles any .sos-arch-sample__btn on page */
(function () {
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-sos-sample-add]');
    if (!btn) return;
    var variantId = btn.dataset.variantId;
    var secId     = btn.dataset.section;
    var msg       = document.getElementById('sos-sample-msg-' + secId);
    if (!variantId) return;

    function setBtn(state) {
      btn.classList.remove('is-loading', 'is-success');
      if (state === 'loading') { btn.disabled = true; btn.classList.add('is-loading'); btn.textContent = 'Adding…'; }
      else if (state === 'success') { btn.disabled = true; btn.classList.add('is-success'); btn.textContent = 'Added ✓'; }
      else { btn.disabled = false; btn.textContent = btn.dataset.origText || 'Add to Cart'; }
    }
    function setMsg(text, kind) {
      if (!msg) return;
      msg.textContent = text || '';
      msg.className = 'sos-arch-sample__msg' + (kind ? ' is-' + kind : '');
    }

    if (!btn.dataset.origText) btn.dataset.origText = btn.textContent.trim();
    setBtn('loading'); setMsg('', null);

    fetch('/cart/add.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: Number(variantId), quantity: 1 }] })
    })
    .then(function (r) { return r.ok ? r.json() : r.json().then(function (d) { throw d; }); })
    .then(function () {
      setBtn('success'); setMsg('Added to your cart!', 'success');
      /* Refresh the theme's mini-cart drawer the same way the rest of the
         theme does it (see theme.js cart.prototype.success). Without these
         calls the drawer stays empty until a hard reload. */
      try {
        if (window.theme && window.theme.miniCart) {
          if (typeof window.theme.miniCart.updateElements === 'function') window.theme.miniCart.updateElements();
          if (typeof window.theme.miniCart.generateCart   === 'function') window.theme.miniCart.generateCart();
        }
      } catch (e) { /* non-fatal: refresh failed, item is still in cart server-side */ }
      /* Open the drawer (theme uses .active on .js-mini-cart) */
      var drawer = document.querySelector('.js-mini-cart, .cardraw, [data-cart-drawer]');
      if (drawer && !drawer.classList.contains('active')) drawer.classList.add('active');
      setTimeout(function () { setBtn('reset'); setMsg('', null); }, 3500);
    })
    .catch(function (err) {
      var m = (err && (err.description || err.message)) || 'Could not add to cart. Please try again.';
      setMsg(m, 'error'); setBtn('reset');
    });
  });
})();
</script>

{%- comment -%}
  Save archetype result so the account dashboard can show it.
  Writes to localStorage immediately (works for all visitors).
  Also fires a silent POST to /account to write the customer metafield
  when the visitor is logged in (requires metafield to have storefront
  Read/Write access in Shopify admin → Custom data → Customers).
{%- endcomment -%}
<script>
(function () {
  var archetype = {{ archetype_name | json }};
  var pageUrl   = {{ page.url | json }};
  var today     = new Date().toISOString().split('T')[0];

  /* 1 — localStorage (always works, any visitor) */
  try {
    var prev = null;
    try { prev = JSON.parse(localStorage.getItem('sos_archetype') || 'null'); } catch (_) {}
    var payload = {
      name: archetype,
      url:  pageUrl,
      /* keep the original quiz date if this same archetype was already saved */
      date: (prev && prev.url === pageUrl && prev.date) ? prev.date : today
    };
    localStorage.setItem('sos_archetype', JSON.stringify(payload));
  } catch (_) {}

  /* 2 — server-side metafield write (only when logged in)
     Works when the three metafields below exist in Shopify admin under
     Settings → Custom data → Customers and have storefront access = Read/Write.
     Metafield keys: custom.archetype_name, custom.archetype_result_url, custom.archetype_date
     This is a fire-and-forget request; failures are silently ignored. */
  {%- if customer -%}
  try {
    var fd = new FormData();
    fd.append('_method', 'put');
    fd.append('customer[metafields][custom][archetype_name]',       archetype);
    fd.append('customer[metafields][custom][archetype_result_url]', pageUrl);
    fd.append('customer[metafields][custom][archetype_date]',       today);
    fetch('/account', {
      method:      'POST',
      credentials: 'same-origin',
      headers:     { 'Accept': 'application/json' },
      body:        fd
    }).catch(function () {});
  } catch (_) {}
  {%- endif -%}
})();
</script>

