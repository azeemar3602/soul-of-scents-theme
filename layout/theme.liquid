<!doctype html>
<html class="no-js " lang="{{ shop.locale }}">
  <head>
	<!-- Added by AVADA SEO Suite -->
	{% include 'avada-seo' %}
	<!-- /Added by AVADA SEO Suite -->
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

    {%- comment -%}
      SoS Tester Mode — redirect every non-whitelisted URL to /pages/quiz.
      Toggle in Theme settings: SoS — Tester mode (quiz only).
    {%- endcomment -%}
    {%- if settings.tester_mode -%}
      {%- assign tester_allowed = 'quiz,the-seducer,the-cosmopolitan,the-romantic,the-indulger,the-luxury-hedonist,the-nostalgic,the-mineralist,the-smooth-operator,the-maximalist' | split: ',' -%}
      {%- if settings.tester_mode_whitelist != blank -%}
        {%- assign extra_allowed = settings.tester_mode_whitelist | replace: ' ', '' | split: ',' -%}
        {%- assign tester_allowed = tester_allowed | concat: extra_allowed -%}
      {%- endif -%}
      {%- assign tester_redirect = false -%}
      {%- if template == 'page' -%}
        {%- unless tester_allowed contains page.handle -%}
          {%- assign tester_redirect = true -%}
        {%- endunless -%}
      {%- else -%}
        {%- assign tester_redirect = true -%}
      {%- endif -%}
      {%- if tester_redirect -%}
        <meta http-equiv="refresh" content="0;url=/pages/quiz">
        <link rel="canonical" href="{{ shop.url }}/pages/quiz">
        <style>html,body{background:#fbf9f6 !important;}body>*{display:none !important;}body::before{content:"Loading…";display:flex;align-items:center;justify-content:center;position:fixed;inset:0;font-family:Georgia,serif;color:#6f6862;font-size:14px;letter-spacing:.04em;}</style>
        <script>window.location.replace('/pages/quiz');</script>
      {%- endif -%}
    {%- endif -%}
    <meta name="viewport" content="width=device-width,initial-scale=1, maximum-scale=1">
    <meta name="theme-color" content="{{ settings.color_header_bg }}">
    <meta name="format-detection" content="telephone=no">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="dns-prefetch" href="https://{{shop.domain }}" crossorigin>
    <link rel="dns-prefetch" href="https://{{shop.permanent_domain }}" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.shopifycdn.com" crossorigin>
    <link rel="preconnect" href="https//fonts.shopifycdn.com/" crossorigin>
    <link rel="preconnect" href="https//cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- unless settings.font_family.system? -%}
      <link rel="preload" as="font" href="{{ settings.font_family | font_url }}" type="font/woff2" crossorigin>
      <link rel="preload" as="font" href="{{ settings.font_family | font_url: 'woff' }}" type="font/woff" crossorigin>
    {%- endunless -%}
    {%- if settings.font_family2.system? == false and settings.font_family2 != settings.font_family -%}
      <link rel="preload" as="font" href="{{ settings.font_family2 | font_url }}" type="font/woff2" crossorigin>
      <link rel="preload" as="font" href="{{ settings.font_family2 | font_url: 'woff' }}" type="font/woff" crossorigin>
    {%- endif -%}
    {%- if settings.favicon != blank -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" type="image/png">
    {%- endif -%}

    <title>
      {{ page_title }}
      {% if current_tags %}
        {% assign meta_tags = current_tags | join: ', ' %}
        &ndash;
        {{ 'general.meta.tags' | t: tags: meta_tags }}
      {% endif %}
      {% if current_page != 1 %}
        &ndash;
        {{ 'general.meta.page' | t: page: current_page }}
      {% endif %}
      {% unless page_title contains shop.name %}
        &ndash;
        {{ shop.name }}
      {% endunless %}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="{{ settings.meta_description | escape }}">
    {%- endif -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'header-css' -%}
    <link rel="preload" href="{{ 'lazysizes.min.js' | asset_url }}" as="script">
    <link rel="preload" href="{{ 'vendor.js' | asset_url }}" as="script">
    <link rel="preload" href="{{ 'swiper-bundle.min.js' | asset_url }}" as="script">
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
    {{ 'judgeme-custom.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }} body-theme {% if settings.productpage == 'product-2' or settings.productpage == 'product-6' or settings.productpage == 'product-7' %} product-hide-breadcrumb {% endif %}{% if settings.tester_mode %} sos-tester-mode{% endif %}">

    {%- if settings.tester_mode and settings.tester_mode_message != blank -%}
      <div class="sos-tester-banner" role="status" aria-live="polite">{{ settings.tester_mode_message }}</div>
    {%- endif -%}

    {%- if settings.tester_mode -%}
    <style>
      /* SoS tester mode — quiz-only preview. Hides every escape route from
         the quiz funnel: nav, cart, search, account, footer columns, etc.
         Keeps the soul-of-scents logo as the only header element so users
         can tell what brand they're on. */
      .sos-tester-mode .site-header__nav,
      .sos-tester-mode .site-header__main-menu,
      .sos-tester-mode .nav-bar,
      .sos-tester-mode .header-bottom,
      .sos-tester-mode .header-topbar,
      .sos-tester-mode .header-topbar-section,
      .sos-tester-mode .js-mini-cart,
      .sos-tester-mode .cardraw,
      .sos-tester-mode .site-header__cart,
      .sos-tester-mode .header--acount,
      .sos-tester-mode .icon-search-header,
      .sos-tester-mode .js-search-mobile,
      .sos-tester-mode .js-toggle-search,
      .sos-tester-mode .site-account,
      .sos-tester-mode .site-header__icon,
      .sos-tester-mode .site-header__link,
      .sos-tester-mode .announcement-bar,
      .sos-tester-mode .header-announcement,
      .sos-tester-mode .site-footer__column,
      .sos-tester-mode .site-footer__column--menu,
      .sos-tester-mode .site-footer__newsletter,
      .sos-tester-mode .footer-newsletter,
      .sos-tester-mode .newsletter-footer,
      .sos-tester-mode .footer__newsletter,
      .sos-tester-mode .site-footer__bottom-content,
      .sos-tester-mode .product-slider,
      .sos-tester-mode .featured-products,
      .sos-tester-mode .featured-collections,
      .sos-tester-mode .icon-cart-header,
      .sos-tester-mode .slide-menu,
      .sos-tester-mode .js-drawer-open,
      .sos-tester-mode .js-cart-count,
      .sos-tester-mode .js-mini-cart-trigger {
        display: none !important;
      }
      .sos-tester-banner {
        position: relative;
        z-index: 99;
        text-align: center;
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        background: #030303;
        color: #ffffff;
        padding: 10px 16px;
        font-family: -apple-system, system-ui, sans-serif;
      }
      /* Make the SOS logo non-clickable in tester mode (so users can't bounce home). */
      .sos-tester-mode .site-header__logo a,
      .sos-tester-mode .site-header__logo-link,
      .sos-tester-mode a.site-header__logo {
        pointer-events: none;
        cursor: default;
      }
    </style>
    {%- endif -%}
    {% assign lazy = false %}
    <img {% if lazy %} loading="lazy" {% endif %} width="99998" height="99999" alt="index" style="pointer-events: none; position: absolute; top: 0; left: 0; width: 99vw; height: 99vh; max-width: 99vw; max-height: 99vh;" src="data:image/svg+xml;base64,">
    {%- render 'loading' -%}
    {%- sections 'header-group' -%}
    <div class="page-container page-element is-moved-by-drawer">
      <main class="main-content" id="MainContent" role="main">
        {%- if settings.enable_animationscroll -%}
          <div id="js-scroll">
        {%- endif -%}
        {%- if settings.enable_animationscroll -%}
          <div data-scroll-section>
        {%- endif -%}
        {%- render 'slideshow' -%}
        {%- if settings.enable_animationscroll -%}
          </div>
        {%- endif -%}
        {{ content_for_layout }}
        {%- if settings.enable_animationscroll -%}
          </div>
        {%- endif -%}
      </main>
      {%- sections 'footer-group' -%}
      {%- liquid
        section 'pnewsletter'
        section 'product-suggest'
        section 'cookie-policy'
        section 'custom-color'
      -%}
    </div>
    {%- liquid
      render 'back-to-top'
      render 'menu-mobile'
      render 'bottom-contents'
      render 'quickview'
      render 'popup-compare'
      render 'header-js'
    -%}

<script>
  (function() {
    var QUIZ_ID = 'KFeGjY';
    var QUIZ_PAGE = '/pages/quiz';
    var STORE_KEY = 'sos_archetype_data';

    function saveArchetypeData(responseId) {
      if (!responseId) return;
      var existing = {};
      try { existing = JSON.parse(localStorage.getItem(STORE_KEY) || '{}'); } catch(e) {}
      var resultUrl = window.location.origin + QUIZ_PAGE + '?r=' + responseId;
      var quizObj = window.quiz || {};
      var data = {
        responseId: responseId,
        resultUrl: resultUrl,
        savedAt: new Date().toISOString()
      };
      if (quizObj.variables && quizObj.variables.highest) {
        data.archetypeKey = quizObj.variables.highest;
      }
      localStorage.setItem(STORE_KEY, JSON.stringify(data));
      localStorage.setItem('sos_quiz_result_url', resultUrl);
    }

    function checkAndSave() {
      var rh = localStorage.getItem('revenuehunt-responseId-' + QUIZ_ID);
      if (rh) {
        try {
          var obj = JSON.parse(rh);
          if (obj && obj.value) saveArchetypeData(obj.value);
        } catch(e) {}
      }
    }

    window.addEventListener('message', function(event) {
      if (!event.data) return;
      var data;
      try { data = typeof event.data === 'string' ? JSON.parse(event.data) : event.data; } catch(e) { return; }
      if (data.channel !== 'revenuehunt:quiz-renderer') return;
      if (data.type === 'isResult') {
        setTimeout(function() {
          var quiz = window.quiz || {};
          var meta = quiz.metadata || {};
          var responseId = meta.responseId || '';
          if (responseId) { saveArchetypeData(responseId); return; }
          checkAndSave();
        }, 1500);
      }
    });

    if (window.location.pathname === QUIZ_PAGE) {
      var urlParams = new URLSearchParams(window.location.search);
      var r = urlParams.get('r');
      if (r) saveArchetypeData(r);
    }

    document.addEventListener('DOMContentLoaded', function() {
      checkAndSave();
    });
  })();
</script>

  </body>
<style>
  .mood-tags-block{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px;justify-content:center}
  .mood-tag{display:inline-block;padding:6px 16px;border-radius:50px;font-size:13px;font-weight:500;letter-spacing:0.01em;cursor:default;background:#f0f0f0;color:#444;border:1px solid #e0e0e0;transition:opacity 0.2s;line-height:1.2}
  @media (max-width:640px){.mood-tags-block{gap:6px}.mood-tag{padding:5px 13px;font-size:12px}}
  .product-card .mood-tags-block{gap:6px;margin:6px 0 8px;justify-content:center}
  .product-card .mood-tag{padding:3px 10px;font-size:11px;font-weight:500;letter-spacing:0}
  .mood-tag--resin-heat{background:#D64249!important;color:#F7D697!important;border-color:#D64249!important}
  .mood-tag--after-dark{background:#1C0D96!important;color:#CDC8F1!important;border-color:#1C0D96!important}
  .mood-tag--nostalgic-notion{background:#C8E8F1!important;color:#786CD6!important;border-color:#C8E8F1!important}
  .mood-tag--sweet-escape{background:#F7D697!important;color:#D64249!important;border-color:#F7D697!important}
  .mood-tag--second-skin{background:#A29AE4!important;color:#E2DFF7!important;border-color:#A29AE4!important}
  .mood-tag--subtle-companion{background:#FAE7E8!important;color:#A29AE4!important;border-color:#FAE7E8!important}
  .mood-tag--grounding-greens{background:#197362!important;color:#63DAC4!important;border-color:#197362!important}
  .mood-tag--main-character{background:#52080B!important;color:#D64249!important;border-color:#52080B!important}
  .mood-tags-block .mood-tag:nth-child(3n+1),.mood-tags-block .mood-tag:nth-child(3n+2),.mood-tags-block .mood-tag:nth-child(3n+3){background:unset;color:unset;border-color:unset}
  </style>
  
</html>